# 装配式镜像：Dockerfile 只 COPY 预编译产物（bin/bili-history）与
# 配置目录（internal/config）；降权入口已下沉到公共基镜。
# 下列排除项都不得命中这两者。

# Git / CI / 文档
.git/
.github/
.gitignore
.dockerignore
README.md
AGENTS.md
LICENSE
NOTICE
CHANGELOG.md
docs/

# Go 构建/测试产物
*.test
*.out
coverage.out
coverage.txt
bilibili-history-go

# 前端源码与依赖（产物经 go:embed 打进二进制，镜像不需要 Node 工具链）
web/node_modules/
web/.nuxt/
web/.output/
web/dist/
web/coverage/
**/node_modules/

# 本地数据 / 配置 / 运行产物
.env
.env.*
config/config.yaml
output/
data/
*.log
logs/

# IDE / OS / 工具目录
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.mimocode/
.qoder/
.mypy_cache/
.ruff_cache/
__pycache__/

# 动态库
*.exe
*.dll
*.so
*.dylib
